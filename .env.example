# Hub
PORT=8787
COFFEE_SHOP_TOKEN=change-me
COFFEE_SHOP_DATA=./data/state.json

# Worker (run one per compute machine)
HUB_URL=http://localhost:8787
NODE_ID=local-macbook
NODE_NAME=MacBook Pro
NODE_KIND=local
WORKSPACE_ROOTS=/path/to/projects
WORKER_CONCURRENCY=2

# Claude Code stays authenticated locally. Do not put Claude OAuth tokens here.
# Run `claude /login` interactively on each worker machine instead.
