# Hub
PORT=8787
COFFEE_SHOP_TOKEN=change-me
COFFEE_SHOP_DATA=./data/state.json

# Isolated artifact previews (remove this entire block to disable preview delivery)
COFFEE_SHOP_PUBLIC_ORIGIN=http://hub.localhost:8787
PREVIEW_PUBLIC_ORIGIN=http://preview.localhost:8788
PREVIEW_BIND_HOST=0.0.0.0
PREVIEW_PORT=8788
# Generate the 64 lowercase hex characters with: openssl rand -hex 32
PREVIEW_SIGNING_KEYS=current:replace-with-64-lowercase-hex-characters
PREVIEW_ACTIVE_SIGNING_KEY_ID=current
PREVIEW_ACCESS_DEFAULT_TTL_SECONDS=900
PREVIEW_ACCESS_MAX_TTL_SECONDS=3600

# Barista control agent (run one per compute machine)
CONTROL_ENDPOINT=http://localhost:8787
BARISTA_ID=local-macbook
BARISTA_NAME=MacBook Pro
BARISTA_KIND=local
WORKSPACE_ROOTS=/path/to/projects
BARISTA_CONCURRENCY=2

# Claude Code stays authenticated locally. Do not put Claude OAuth tokens here.
# Run `claude /login` interactively on each compute machine instead.
